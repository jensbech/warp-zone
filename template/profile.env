# Example profile for the warp-zone template.
#
# `just new` writes one of these per profile into ~/warp/<name>; this copy lets
# the template build and run on its own. It mirrors the default a fresh profile
# gets: minimal (no extra tools) and hermetic (no host mount).
#
# To add tools or host links, set the matching flags to "true" (run `just new`
# to see the full list), or just recreate the profile with the wizard.

# The profile name is the only name you choose. Everything Docker sees is
# prefixed with "warp-" so warp-zone never collides with your other containers.
PROFILE_NAME="dev"
CONTAINER_NAME="warp-dev"
IMAGE_NAME="warp-dev:latest"
WORK_VOLUME="warp-dev-work"
DOCKER_VOLUME="warp-dev-docker"
BASE_IMAGE="ubuntu:24.04"

# Your identity inside the container. PROFILE_PROMPT is the label in the shell prompt.
APP_USER="dev"
APP_UID="1001"
PROFILE_PROMPT="DEV"

# "max" gives the container everything the Docker VM has. Use a value like 8 / 16G to cap.
CPUS="max"
MEMORY="max"

# Empty DOTFILES_DIR = hermetic: nothing from the host is mounted.
DOTFILES_DIR=""

# Always published on 127.0.0.1 so SSH can be switched on later without
# recreating the container. INCLUDE_SSH decides whether sshd is installed.
SSH_PORT="2200"
INCLUDE_SSH="false"
SSH_HOSTNAME=""
SSH_PUBKEY=""

# Extra flags for the profile's own dockerd, e.g. "--mtu 1400" on odd networks.
DOCKERD_ARGS=""
