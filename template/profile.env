# Example profile for the warp-zone template.
#
# `just new` writes one of these per profile into ~/container/<name>; this copy
# lets the template build and run on its own. It mirrors the default a fresh
# profile gets: minimal (no extra tools) and hermetic (no host mount).
#
# To add tools or host links, set the matching flags to "true" (run `just new`
# to see the full list), or just recreate the profile with the wizard.

# The profile name is the only name you choose; the container and image names
# follow it, and the Linux user defaults to it too.
PROFILE_NAME="dev"
CONTAINER_NAME="dev"
IMAGE_NAME="dev:latest"
BASE_IMAGE="ubuntu:24.04"

# Your identity inside the container. PROFILE_PROMPT is the label in the shell prompt.
APP_USER="dev"
APP_UID="1001"
PROFILE_PROMPT="DEV"

# "max" gives the container all host CPU cores / RAM. Use a value like 8 / 16G to cap.
CPUS="max"
MEMORY="max"

# Empty DOTFILES_DIR = hermetic: nothing from the host is mounted.
DOTFILES_DIR=""

# SSH access (off by default). Enable to reach the profile with `ssh <alias>`.
INCLUDE_SSH="false"
SSH_HOSTNAME=""
SSH_PUBKEY=""
