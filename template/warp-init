#!/usr/bin/env bash
set -uo pipefail

# PID 1 for every profile. Brings up the inner Docker daemon, sshd and T3 Code, then
# idles so the container stays alive for `docker exec`.

log() { printf 'warp-init: %s\n' "$1"; }

if [ -f /sys/fs/cgroup/cgroup.controllers ]; then
  mkdir -p /sys/fs/cgroup/init
  xargs -rn1 < /sys/fs/cgroup/cgroup.procs > /sys/fs/cgroup/init/cgroup.procs 2>/dev/null || :
  sed -e 's/ / +/g' -e 's/^/+/' < /sys/fs/cgroup/cgroup.controllers \
    > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || :
fi

if command -v dockerd >/dev/null 2>&1; then
  mkdir -p /var/lib/docker /var/log
  # We are PID 1 on a fresh boot, so any pidfile or socket left in the container
  # layer is from the previous run. dockerd refuses to start otherwise, because
  # the recorded PID gets reused by an unrelated process after a restart.
  rm -f /var/run/docker.pid /var/run/docker.sock /run/docker.pid /run/docker.sock
  rm -f /var/run/containerd/containerd.pid /run/containerd/containerd.pid /run/docker/containerd/containerd.pid
  # shellcheck disable=SC2086
  dockerd ${DOCKERD_ARGS:-} >/var/log/dockerd.log 2>&1 &
  ready=false
  for _ in $(seq 1 180); do
    if docker info >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 0.5
  done
  if [ "$ready" = true ]; then
    log "docker engine ready ($(docker version --format '{{.Server.Version}}' 2>/dev/null))"
  else
    log 'docker engine did not come up within 90s — see /var/log/dockerd.log'
  fi
fi

if command -v sshd >/dev/null 2>&1; then
  mkdir -p /run/sshd
  [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
  /usr/sbin/sshd && log 'sshd listening on 22'
fi

# The profile is its own tailnet node. State lives next to T3 Code's in ~/work so
# a rebuilt container comes back as the same machine. `tailscale up` blocks
# until someone logs in, so it runs detached; `tailnet` reads the login link.
if [ "${T3CODE_ACCESS:-local}" = tailscale ] && command -v tailscaled >/dev/null 2>&1; then
  ts_state="$APP_HOME/work/.tailscale"
  mkdir -p /var/run/tailscale /var/log /etc/warp-zone
  install -d -m 0700 "$ts_state"
  # `tailnet` runs from login shells that do not see the container's env, so it
  # reads the node settings from here.
  printf 'TAILNET_HOSTNAME=%q\nTAILNET_OPERATOR=%q\nTAILNET_TAGS=%q\n' "$(hostname)" "$APP_USER" "${TAILSCALE_TAGS:-}" > /etc/warp-zone/tailnet.env
  ts_args=(--state="$ts_state/tailscaled.state" --socket=/var/run/tailscale/tailscaled.sock)
  if [ ! -c /dev/net/tun ]; then
    ts_args+=(--tun=userspace-networking)
  fi
  tailscaled "${ts_args[@]}" >/var/log/tailscaled.log 2>&1 &
  ts_ready=false
  for _ in $(seq 1 40); do
    if tailscale status --json >/dev/null 2>&1; then
      ts_ready=true
      break
    fi
    sleep 0.25
  done
  if [ "$ts_ready" = true ]; then
    (
      tailnet _up >>/var/log/tailscale-up.log 2>&1 \
        && tailnet serve >>/var/log/tailscale-up.log 2>&1
    ) &
    log "tailscaled running as node $(hostname)${TAILSCALE_TAGS:+ with $TAILSCALE_TAGS} (state in ~/work/.tailscale)"
  else
    log 'tailscaled did not come up — see /var/log/tailscaled.log'
  fi
fi

if [ "${T3CODE_SERVE:-false}" = true ] && command -v t3 >/dev/null 2>&1; then
  t3code_home="$APP_HOME/work/.t3code"
  (
    while :; do
      if [ "$(stat -c %U "$APP_HOME/work" 2>/dev/null)" = "$APP_USER" ]; then
        install -d -m 0700 -o "$APP_USER" -g "$APP_USER" "$t3code_home"
        su - "$APP_USER" -c "cd ~/work && exec t3 serve --host 0.0.0.0 --port 3773 --no-browser --base-dir '$t3code_home' ~/work" >>/var/log/t3code.log 2>&1
      fi
      sleep 3
    done
  ) &
  log 'T3 Code serving on 3773'
fi

exec sleep infinity
